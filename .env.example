# ============================================================
# DATABASE — PostgreSQL
# ============================================================
# Configurações de conexão com o banco de dados PostgreSQL.

POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=nome_do_banco


# ============================================================
# FRONTEND — React / Vite
# ============================================================
# Variáveis iniciadas com VITE_ são disponibilizadas ao
# frontend através do Vite.
#
# Informe a URL base da API REST utilizada pela aplicação.

VITE_HOST_REACT=http://localhost:8000


# ============================================================
# API — Segurança
# ============================================================
# Chave secreta utilizada pela API para operações que
# exigem autenticação/assinatura segura.

SECRET_KEY=sua_chave_secreta